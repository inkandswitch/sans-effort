# Generated by Cargo
debug
target

# Nix
.direnv
result
result-*

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# dhat heap profiling output
**/dhat-heap.json

# rustc snippet output
rust_out

# Quint / Apalache output (spec checks)
**/_apalache-out/

# Java classes the editor's tooling compiles beside demo/driven/java/Main.java
*.class

# Python bytecode (the demo host, imported as a module)
__pycache__/

# wasm / npm artifacts
**/dist/
**/node_modules/
**/.pnpm-store/
**/pkg/

# editor cruft
.idea
.vscode
*~
\#*\#
.\#*

# session artifacts
.ignore/
